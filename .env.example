AI_RUNTIME_APP_NAME=yn-ai-setu-ai-runtime
AI_RUNTIME_ENVIRONMENT=local
AI_RUNTIME_HOST=0.0.0.0
AI_RUNTIME_PORT=8000
AI_RUNTIME_DEBUG=false
AI_RUNTIME_LOG_LEVEL=INFO
AI_RUNTIME_READY_ON_STARTUP=true

# Local development only. Keep false outside local development.
AI_RUNTIME_BYPASS_AUTH=true

# JWT settings. Use a strong secret of at least 32 characters.
AI_RUNTIME_JWT_SECRET=change_this_to_a_long_random_secret_change_this_to_at_least_32_chars_long
AI_RUNTIME_JWT_ALGORITHM=HS256
# AI_RUNTIME_JWT_ISSUER=
# AI_RUNTIME_JWT_AUDIENCE=

# Model Gateway
AI_RUNTIME_MODEL_GATEWAY_URL=http://localhost:9000
AI_RUNTIME_MODEL_GATEWAY_CHAT_PATH=/generate
AI_RUNTIME_MODEL_GATEWAY_PLANNER_PATH=/planner
AI_RUNTIME_MODEL_GATEWAY_SECURITY_PATH=/security/classify
AI_RUNTIME_MODEL_GATEWAY_TIMEOUT_SECONDS=30
AI_RUNTIME_MODEL_GATEWAY_CONNECT_TIMEOUT_SECONDS=5
AI_RUNTIME_MODEL_GATEWAY_READ_TIMEOUT_SECONDS=30
AI_RUNTIME_MODEL_GATEWAY_PLANNER_TIMEOUT_SECONDS=30
AI_RUNTIME_MODEL_GATEWAY_PLANNER_CONNECT_TIMEOUT_SECONDS=5
AI_RUNTIME_MODEL_GATEWAY_PLANNER_READ_TIMEOUT_SECONDS=30
AI_RUNTIME_MODEL_GATEWAY_GENERATE_TIMEOUT_SECONDS=90
AI_RUNTIME_MODEL_GATEWAY_GENERATE_CONNECT_TIMEOUT_SECONDS=5
AI_RUNTIME_MODEL_GATEWAY_GENERATE_READ_TIMEOUT_SECONDS=90
AI_RUNTIME_MODEL_GATEWAY_SECURITY_TIMEOUT_SECONDS=30
AI_RUNTIME_MODEL_GATEWAY_SECURITY_CONNECT_TIMEOUT_SECONDS=5
AI_RUNTIME_MODEL_GATEWAY_SECURITY_READ_TIMEOUT_SECONDS=30
AI_RUNTIME_MODEL_GATEWAY_MAX_RETRIES=2
AI_RUNTIME_MODEL_GATEWAY_SEND_PLANNER_PROMPT=true

# MCP Client
AI_RUNTIME_MCP_SERVERS_CONFIG_PATH=app/mcp_client/config/servers.yaml
AI_RUNTIME_MCP_CONNECT_TIMEOUT_SECONDS=5
AI_RUNTIME_MCP_READ_TIMEOUT_SECONDS=30
AI_RUNTIME_MCP_WRITE_TIMEOUT_SECONDS=10
AI_RUNTIME_MCP_POOL_TIMEOUT_SECONDS=5
AI_RUNTIME_MCP_MAX_RETRIES=2
AI_RUNTIME_MCP_VERIFY_TLS=true
AI_RUNTIME_MCP_VALIDATE_CONTRACTS_ON_STARTUP=false
VIDHYA_MCP_URL=http://localhost:8001

# Local auth context used only when AI_RUNTIME_BYPASS_AUTH=true
AI_RUNTIME_LOCAL_SUBJECT=developer
AI_RUNTIME_LOCAL_USER_ID=developer
AI_RUNTIME_LOCAL_ORGANIZATION_ID=yntec
AI_RUNTIME_LOCAL_BRANCH_ID=main
AI_RUNTIME_LOCAL_APP_ID=vidhya
AI_RUNTIME_LOCAL_TENANT_ID=yn
AI_RUNTIME_LOCAL_LOCALE=en-IN
AI_RUNTIME_LOCAL_SESSION_ID=local-session
AI_RUNTIME_LOCAL_APPLICATION_IDS=["hrms","vidhya"]
AI_RUNTIME_LOCAL_ROLES=["SUPER_ADMIN"]
AI_RUNTIME_LOCAL_PERMISSIONS=["*"]

# Paths and CORS
AI_RUNTIME_TOOL_REGISTRY_PATH=tool-registry
AI_RUNTIME_GUARDRAILS_CONFIG_PATH=app/config/guardrails.yaml
AI_RUNTIME_CURRENT_INFO_CONFIG_PATH=app/config/current_info.yaml
AI_RUNTIME_ALLOWED_ORIGINS=["*"]
